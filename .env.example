# Copie ce fichier en .env à la racine. Ne versionne jamais .env.
# .env sert au développement et aux tests réels. Dans l'app, les clés se saisissent
# dans Réglages et vont dans le trousseau du système (Secret Service).
# Au premier lancement, l'app importe dans le trousseau les clés présentes ici.
# Seuls les noms ci-dessous sont lus ; toute autre variable est ignorée.

# LLM principal pendant le développement (API compatible OpenAI)
DEEPSEEK_API_KEY=
# LLM secondaire et modèles vision
OPENROUTER_API_KEY=
# Plus tard : les adaptateurs s'activent dès que la clé apparaît
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Meta (Muse Spark, Muse Wonder, Muse Voice Transcribe), dev.meta.ai : profil « Tout Meta »
MODEL_API_KEY=
# Synthèse vocale (Cartesia Sonic)
CARTESIA_API_KEY=
GROQ_API_KEY=              # transcription de la voix (Whisper large-v3), console.groq.com
# Recherche web
TAVILY_API_KEY=
# Jeton GitHub fine-grained (lecture des dépôts, issues et PR)
GITHUB_TOKEN=
# Intégration interne Notion (partage les pages voulues avec elle)
NOTION_TOKEN=
# Client OAuth Google de type « Desktop app », API Calendar activée
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Bot créé via @BotFather
TELEGRAM_BOT_TOKEN=
# Ton identifiant Telegram (via @userinfobot) : seul expéditeur servi
TELEGRAM_ALLOWED_USER_ID=
